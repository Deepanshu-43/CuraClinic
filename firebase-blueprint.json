{
  "entities": {
    "patients": {
      "title": "Patient",
      "description": "Information about a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "dob": { "type": "string", "format": "date" },
        "gender": { "type": "string", "enum": ["Male", "Female", "Other"] },
        "address": { "type": "string" },
        "bloodGroup": { "type": "string" },
        "allergies": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "email", "phone"]
    },
    "appointments": {
      "title": "Appointment",
      "description": "Details of a patient appointment",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "patientName": { "type": "string" },
        "doctorId": { "type": "string" },
        "doctorName": { "type": "string" },
        "dateTime": { "type": "string", "format": "date-time" },
        "status": { "type": "string", "enum": ["Scheduled", "Confirmed", "Completed", "Cancelled"] },
        "reason": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["patientId", "dateTime", "status"]
    },
    "medical_records": {
      "title": "Medical Record",
      "description": "Clinical history and diagnostic notes for a patient",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "patientId": { "type": "string" },
        "date": { "type": "string", "format": "date-time" },
        "diagnosis": { "type": "string" },
        "treatment": { "type": "string" },
        "prescriptions": { "type": "string" },
        "vitals": {
          "type": "object",
          "properties": {
            "bp": { "type": "string" },
            "temp": { "type": "string" },
            "weight": { "type": "string" }
          }
        },
        "doctorName": { "type": "string" },
        "aiSummary": { "type": "string" }
      },
      "required": ["patientId", "date", "diagnosis"]
    }
  },
  "firestore": {
    "patients": {
      "schema": "patients",
      "description": "Collection of patient records"
    },
    "appointments": {
      "schema": "appointments",
      "description": "Collection of patient appointments"
    },
    "medical_records": {
      "schema": "medical_records",
      "description": "Collection of medical visits and reports"
    },
    "users": {
        "schema": "object",
        "description": "User profiles for staff members"
    }
  }
}
